# Copy to .env.selfhost, then edit for your existing Docker networks/LLM.
# Never commit the filled-in file. This default assumes an Ollama container
# named ollama on the same Docker network as Wordfeud Helper and Caddy.
CADDY_NETWORK=caddy
SCAN_API_BASE_URL=http://ollama:11434/v1
SCAN_API_KEY=ollama
SCAN_MODEL=qwen3.6:27b
APP_PORT=8787
# Host interface for the published APP_PORT. Keep 127.0.0.1 for a
# loopback-only service (host Caddy route + health checks). Set 0.0.0.0 to
# expose the web app and /api/* on your LAN for browsers and Expo Go.
APP_BIND=127.0.0.1